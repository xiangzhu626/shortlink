<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="bg-white shadow-sm rounded-lg p-6">
        <div class="mb-6">
            <h2 class="text-2xl font-bold text-gray-900">欢迎回来，<%= user.username %></h2>
            <p class="mt-1 text-sm text-gray-500">这是您的仪表板主页</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- 统计卡片 -->
            <div class="bg-blue-50 rounded-lg p-4">
                <div class="flex items-center">
                    <div class="flex-shrink-0 bg-blue-500 rounded-md p-3">
                        <i class="fas fa-link text-white"></i>
                    </div>
                    <div class="ml-4">
                        <h3 class="text-lg font-medium text-gray-900">总链接数</h3>
                        <p class="text-2xl font-semibold text-blue-600">0</p>
                    </div>
                </div>
            </div>

            <div class="bg-green-50 rounded-lg p-4">
                <div class="flex items-center">
                    <div class="flex-shrink-0 bg-green-500 rounded-md p-3">
                        <i class="fas fa-chart-line text-white"></i>
                    </div>
                    <div class="ml-4">
                        <h3 class="text-lg font-medium text-gray-900">总访问量</h3>
                        <p class="text-2xl font-semibold text-green-600">0</p>
                    </div>
                </div>
            </div>

            <div class="bg-purple-50 rounded-lg p-4">
                <div class="flex items-center">
                    <div class="flex-shrink-0 bg-purple-500 rounded-md p-3">
                        <i class="fas fa-clock text-white"></i>
                    </div>
                    <div class="ml-4">
                        <h3 class="text-lg font-medium text-gray-900">最近创建</h3>
                        <p class="text-sm text-gray-500">暂无数据</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- 快速操作 -->
        <div class="mt-8">
            <h3 class="text-lg font-medium text-gray-900 mb-4">快速操作</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <a href="/urls/create" class="flex items-center p-4 bg-white border rounded-lg hover:bg-gray-50">
                    <i class="fas fa-plus-circle text-blue-500 text-xl"></i>
                    <div class="ml-4">
                        <h4 class="text-base font-medium text-gray-900">创建短链接</h4>
                        <p class="text-sm text-gray-500">快速生成新的短链接</p>
                    </div>
                </a>
                <a href="/urls/manage" class="flex items-center p-4 bg-white border rounded-lg hover:bg-gray-50">
                    <i class="fas fa-list text-green-500 text-xl"></i>
                    <div class="ml-4">
                        <h4 class="text-base font-medium text-gray-900">管理链接</h4>
                        <p class="text-sm text-gray-500">查看和管理您的短链接</p>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div> 